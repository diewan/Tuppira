# The Dockerfile is built from the projects monorepo root. Send only the two
# workspaces it deliberately copies, never local artifacts or unrelated repos.
**
!csv-protocol/
!csv-protocol/**
!csv-apps/
!csv-apps/tuppira/
!csv-apps/tuppira/**

csv-protocol/**/target/
csv-apps/tuppira/**/target/
csv-apps/tuppira/data/
csv-apps/tuppira/.git/
