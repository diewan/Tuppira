# Built from the diewan monorepo root. Send only the tuppira workspace plus
# parwana (its path dependency); never local artifacts or unrelated repos.
**
!parwana/
!parwana/**
!tuppira/
!tuppira/**

parwana/target/
parwana/**/target/
tuppira/target/
tuppira/**/target/
tuppira/data/
**/.git/
**/node_modules/
**/*.pem
**/.env
**/.env.*
