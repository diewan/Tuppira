# The Dockerfile is built from the projects monorepo root. Send only the two
# workspaces it deliberately copies, never local artifacts or unrelated repos.
**
!csv-protocol/
!csv-protocol/**
!csv-apps/
!csv-apps/csv-explorer/
!csv-apps/csv-explorer/**

csv-protocol/**/target/
csv-apps/csv-explorer/**/target/
csv-apps/csv-explorer/data/
csv-apps/csv-explorer/.git/
